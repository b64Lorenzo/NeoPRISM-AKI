<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="ModelName">
    <xs:annotation><xs:documentation>Name of the algorithm configuration selected by model/activeModel.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="perceptron" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RunMode">
    <xs:annotation><xs:documentation>Execution mode supported by the perceptron component.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="train-validation" />
      <xs:enumeration value="novel-data" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LogLevel">
    <xs:annotation><xs:documentation>Minimum severity written by the general logger.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="DEBUG" />
      <xs:enumeration value="INFO" />
      <xs:enumeration value="WARNING" />
      <xs:enumeration value="ERROR" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PlotPhase">
    <xs:annotation><xs:documentation>Phase filter used when generating parameter distribution plots.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="all" />
      <xs:enumeration value="preoperative" />
      <xs:enumeration value="duringoperative" />
      <xs:enumeration value="postoperative" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PlotTheme">
    <xs:annotation><xs:documentation>Interactive Plotly color scheme used by preprocessing study plots.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="light" />
      <xs:enumeration value="dark" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TimeSeriesGroupBy">
    <xs:annotation><xs:documentation>Grouping used to create time-series plot files.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="parameter" />
      <xs:enumeration value="class" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="pipelineConfiguration">
    <xs:annotation><xs:documentation>Root run configuration. Child order defines the pipeline: logging settings, preprocessing, then model.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="logging" type="LoggingType">
          <xs:annotation><xs:documentation>The logger configuration is stored directly under pipelineConfiguration.</xs:documentation></xs:annotation>
        </xs:element>
        <xs:element name="preprocessing" type="PreprocessingType">
          <xs:annotation><xs:documentation>Preprocessing stage. It executes before the model stage when enabled.</xs:documentation></xs:annotation>
        </xs:element>
        <xs:element name="model" type="ModelType">
          <xs:annotation><xs:documentation>Model stage. It executes after preprocessing when enabled.</xs:documentation></xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" use="required" fixed="1">
        <xs:annotation><xs:documentation>Pipeline configuration format version. Version 1 is currently supported.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:anyAttribute namespace="http://www.w3.org/2001/XMLSchema-instance" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="parameterMap" type="ParameterMapType">
    <xs:annotation><xs:documentation>Root of a standalone typed parameter catalog; the same schema also validates phase-owned definitions in the pipeline.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:complexType name="LoggingType">
    <xs:annotation><xs:documentation>Logger destination and minimum severity.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="directory" type="xs:string">
        <xs:annotation><xs:documentation>Log directory, relative to the project root unless absolute.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="level" type="LogLevel">
        <xs:annotation><xs:documentation>Minimum severity: DEBUG, INFO, WARNING, or ERROR.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PreprocessingType">
    <xs:annotation><xs:documentation>Ordered preprocessing stage: inputs, outputs, combined parameters and selection, parameter descriptions, CSV header descriptions, and plots.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether preprocessing reads source CSVs and creates patient-level outputs.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="inputDirectory" type="InputDirectoryType">
        <xs:annotation><xs:documentation>One CSV input directory, relative to the project root unless absolute.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="outputDirectory" type="xs:string">
        <xs:annotation><xs:documentation>Preprocessing output directory, relative to the project root unless absolute.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="parameters" type="EmbeddedParameterMapType">
        <xs:annotation><xs:documentation>Selection controls and shared typed settings followed by pre, during, and post phase-owned definitions.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="parameterDescriptions" type="DescriptionsType">
        <xs:annotation><xs:documentation>Settings for writing the parameter reference document.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="csvHeaderDescriptions" type="CsvHeaderDescriptionsType">
        <xs:annotation><xs:documentation>Independent header-only inventory and filename-family summary for the configured CSV inputs.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="plotting" type="PreprocessingPlotType">
        <xs:annotation><xs:documentation>Settings for preprocessing heatmaps, distributions, and time-series plots.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IdListType">
    <xs:annotation><xs:documentation>Zero or more parameter IDs, used for include, exclude, model omission, and time-series selection lists.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="xs:string" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation>Stable parameter ID or pseudonymous patient ID used by the surrounding list setting.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ClassNameListType">
    <xs:annotation><xs:documentation>Zero or more XML class names used to filter time-series parameters.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="xs:string" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation>Exact class name from the parameter's XML class group.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TimeSeriesPlotType">
    <xs:annotation><xs:documentation>Runs phase-relative Plotly HTML plotting from the generated time_series.csv or an existing file in the configured output directory.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether the time-series plotter runs; this switch is independent of the heatmap/distribution run switch.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="groupBy" type="TimeSeriesGroupBy">
        <xs:annotation><xs:documentation>parameter creates one interactive HTML chart per parameter; class creates one multi-panel HTML chart per class.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="parameterIds" type="IdListType">
        <xs:annotation><xs:documentation>Optional time-series parameter IDs; an empty list selects all configured time-series parameters.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="classNames" type="ClassNameListType">
        <xs:annotation><xs:documentation>Optional exact XML class names; an empty list does not restrict classes.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="patientIds" type="IdListType">
        <xs:annotation><xs:documentation>Optional pseudonymous patient IDs from time_series.csv; an empty list selects all patients.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="outputDirectory" type="xs:string">
        <xs:annotation><xs:documentation>Output directory for interactive HTML charts and a shared local Plotly.js bundle, relative to the project root unless absolute.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DashboardLayoutType">
    <xs:annotation><xs:documentation>Reusable bounded dimensions for compact charts and scrollable detail panels.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="chartHeight" type="xs:positiveInteger">
        <xs:annotation><xs:documentation>Fixed chart height in pixels (runtime range 320-900).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="panelMaxHeight" type="xs:positiveInteger">
        <xs:annotation><xs:documentation>Maximum scrollable table height in pixels (runtime range 120-900).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PatientTimelineType">
    <xs:annotation><xs:documentation>Configures a patient-selectable Plotly dashboard with operation-window numeric series from the during.availableClasses inventory, a selectable series dropdown, a phase-grouped event-and-boundary timeline, pre/post tables, and patient-level summaries.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether to generate the patient timeline dashboard; independent of preprocessing heatmap and time-series plot switches.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="patientIds" type="IdListType">
        <xs:annotation><xs:documentation>Optional generated pseudonymous patient IDs to include; empty means all discovered patient families.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="compareAllPatients" type="xs:boolean">
        <xs:annotation><xs:documentation>Adds an all-patient comparison view to the dashboard selector.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="includeStudyPlots" type="xs:boolean">
        <xs:annotation><xs:documentation>Embeds other preprocessing Plotly HTML artifacts in the dashboard when they were generated.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="layout" type="DashboardLayoutType">
        <xs:annotation><xs:documentation>Fixed chart height and scrollable detail-panel height.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="output" type="xs:string">
        <xs:annotation><xs:documentation>Destination .html path for the offline interactive patient timeline dashboard.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DescriptionsType">
    <xs:annotation><xs:documentation>Controls generation of the human-readable parameter reference.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether the parameter reference document is generated.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="output" type="xs:string">
        <xs:annotation><xs:documentation>Destination Markdown file for the parameter reference.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CsvHeaderDescriptionsType">
    <xs:annotation><xs:documentation>Independent header-only CSV inspection, including per-file headers, numbered filename parts, and aggregate counts.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether to inspect CSV headers. This can run even when patient preprocessing is disabled.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="inventoryOutput" type="xs:string">
        <xs:annotation><xs:documentation>CSV output with source index, relative CSV filename, filename family, numeric part, column position, and exact header.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="summaryOutput" type="xs:string">
        <xs:annotation><xs:documentation>Markdown summary of files, numbered filename families, schema groups, and header presence counts.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PatientMissingnessPlotType">
    <xs:annotation><xs:documentation>Controls the Plotly heatmap showing missing pre-operative features by pseudonymous patient.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether the patient-by-feature missingness heatmap is generated when preprocessing plots are enabled.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="output" type="xs:string">
        <xs:annotation><xs:documentation>Destination .html path for the interactive patient missingness heatmap.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PreprocessingPlotType">
    <xs:annotation><xs:documentation>Controls preprocessing value heatmaps, patient missingness heatmap, parameter distributions, and optional time-series plots.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether preprocessing heatmaps are generated.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="distributions" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether parameter distributions are generated in addition to enabled heatmaps.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="phase" type="PlotPhase">
        <xs:annotation><xs:documentation>Distribution phase filter: all, preoperative, duringoperative, or postoperative.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="bins" type="xs:positiveInteger">
        <xs:annotation><xs:documentation>Positive number of histogram bins for numeric distributions.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="theme" type="PlotTheme">
        <xs:annotation><xs:documentation>Light or dark Plotly theme applied to preprocessing heatmaps, distributions, time series, and the study dashboard.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="missingnessByPatient" type="PatientMissingnessPlotType">
        <xs:annotation><xs:documentation>Configures the default interactive heatmap of missing pre-operative data by patient.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="timeSeries" type="TimeSeriesPlotType">
        <xs:annotation><xs:documentation>Optional XML-controlled time-series plotting stage that consumes the generated or existing time_series.csv.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="patientTimeline" type="PatientTimelineType">
        <xs:annotation><xs:documentation>Optional offline patient timeline dashboard across pre-operative, during-operative, and post-operative phases.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ModelType">
    <xs:annotation><xs:documentation>Model stage. activeModel names the model section whose settings are used.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="activeModel" type="ModelName">
        <xs:annotation><xs:documentation>Name of the model subsection to execute.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="perceptron" type="PerceptronType">
        <xs:annotation><xs:documentation>Perceptron-specific settings; additional model sections are declared here and in the schema sequence.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PerceptronType">
    <xs:annotation><xs:documentation>Perceptron run switch, mode, training/validation settings, novel-data settings, and plots.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether the perceptron executes when it is the active model.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="mode" type="RunMode">
        <xs:annotation><xs:documentation>Selects train-validation or novel-data prediction.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="trainingValidation" type="TrainingValidationType">
        <xs:annotation><xs:documentation>Settings for labeled training and held-out validation.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="novelData" type="NovelDataType">
        <xs:annotation><xs:documentation>Settings for prediction using feature-only data and a saved model.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="plotting" type="ModelPlotType">
        <xs:annotation><xs:documentation>Optional validation confusion-matrix plot settings.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TrainingValidationType">
    <xs:annotation><xs:documentation>Inputs, outputs, split settings, training limits, seed, and excluded feature IDs.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="vectors" type="xs:string">
        <xs:annotation><xs:documentation>Feature-only patient vectors used when preprocessing is disabled.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="outcomes" type="xs:string">
        <xs:annotation><xs:documentation>Patient-keyed outcome CSV used when preprocessing is disabled.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="trainingSet" type="xs:string">
        <xs:annotation><xs:documentation>Destination CSV for labeled training rows.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="validationSet" type="xs:string">
        <xs:annotation><xs:documentation>Destination CSV for validation features and predictions, without true targets.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="modelOutput" type="xs:string">
        <xs:annotation><xs:documentation>Destination JSON file for trained weights and aggregate metrics.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="trainFraction" type="xs:decimal">
        <xs:annotation><xs:documentation>Fraction of eligible rows assigned to training; the rest is validation.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="epochs" type="xs:positiveInteger">
        <xs:annotation><xs:documentation>Maximum number of perceptron training passes.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="seed" type="xs:integer">
        <xs:annotation><xs:documentation>Seed controlling the repeatable train/validation split.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="omit" type="IdListType">
        <xs:annotation><xs:documentation>Feature IDs to omit from training. Configure exclusions here, not in trainer code.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NovelDataType">
    <xs:annotation><xs:documentation>Previously trained model and feature-only input/output paths for prediction.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="vectors" type="xs:string">
        <xs:annotation><xs:documentation>Feature-only patient vectors used when preprocessing is disabled.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="modelInput" type="xs:string">
        <xs:annotation><xs:documentation>Previously trained model JSON used for prediction.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="predictions" type="xs:string">
        <xs:annotation><xs:documentation>Destination CSV for patient IDs and predictions.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ModelPlotType">
    <xs:annotation><xs:documentation>Controls the aggregate validation confusion-matrix plot.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="run" type="xs:boolean">
        <xs:annotation><xs:documentation>Whether the interactive validation confusion-matrix HTML plot is generated.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="output" type="xs:string">
        <xs:annotation><xs:documentation>Destination .html path for the interactive validation confusion matrix.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EmbeddedParameterMapType">
    <xs:annotation><xs:documentation>Compact shared settings followed by the three phase-owned parameter sections.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="settings" type="ParameterSettingsType">
        <xs:annotation><xs:documentation>Shared settings without workbook or source-sheet metadata.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="preOperative" type="RelevantPhaseType">
        <xs:annotation><xs:documentation>Pre-operative parameter definitions and Epic-class groups.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="duringOperative" type="DuringRelevantPhaseType">
        <xs:annotation><xs:documentation>During-operative definitions and available Epic class names for operation-only numeric timeline plots; these raw values are visualization-only unless explicitly mapped.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="postOperative" type="PostRelevantPhaseType">
        <xs:annotation><xs:documentation>Post-operative definitions with individual measurements, outcomes and optional class failure.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="formatVersion" use="required" fixed="1">
      <xs:annotation><xs:documentation>Typed catalog format version.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="EpicClassNameListType">
    <xs:annotation><xs:documentation>Explicit Epic class inventory whose numeric source fields are available to the operation timeline visualization.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="className" type="xs:string" minOccurs="1" maxOccurs="unbounded">
        <xs:annotation><xs:documentation>Exact Epic class prefix, such as epic.LAB.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DuringRelevantPhaseType">
    <xs:annotation><xs:documentation>During-operative definitions plus the class inventory for raw, visualization-only time-series plotting.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:group ref="PhaseControls" />
      <xs:element name="availableClasses" type="EpicClassNameListType" minOccurs="0">
        <xs:annotation><xs:documentation>Optional explicit inventory of source Epic classes for numeric operation-window plotting; this does not promote fields into model inputs.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="parameter" type="DefinedParameterType">
          <xs:annotation><xs:documentation>One explicitly mapped during-operative parameter.</xs:documentation></xs:annotation>
        </xs:element>
        <xs:element name="class" type="DefinedClassType">
          <xs:annotation><xs:documentation>Group of explicitly mapped during-operative parameters belonging to one Epic class.</xs:documentation></xs:annotation>
        </xs:element>
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="PhaseSelection" />
  </xs:complexType>
  <xs:complexType name="RelevantPhaseType">
    <xs:annotation><xs:documentation>Definitions for a phase; class groups contain only explicitly defined matching fields.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:group ref="PhaseControls" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="parameter" type="DefinedParameterType">
          <xs:annotation><xs:documentation>One parameter with typed metadata and source fields.</xs:documentation></xs:annotation>
        </xs:element>
        <xs:element name="class" type="DefinedClassType">
          <xs:annotation><xs:documentation>Group of parameter definitions belonging to this Epic class.</xs:documentation></xs:annotation>
        </xs:element>
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="PhaseSelection" />
  </xs:complexType>
  <xs:complexType name="PostRelevantPhaseType">
    <xs:annotation><xs:documentation>Post-operative definitions, measurements, and outcome criteria.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:group ref="PhaseControls" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="parameter" type="DefinedParameterType">
          <xs:annotation><xs:documentation>Post-operative parameter with optional measurement and outcome_criteria typed entries.</xs:documentation></xs:annotation>
        </xs:element>
        <xs:element name="class" type="PostDefinedClassType">
          <xs:annotation><xs:documentation>Post-operative definitions with optional shared nonempty failure.</xs:documentation></xs:annotation>
        </xs:element>
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="PhaseSelection" />
  </xs:complexType>
  <xs:complexType name="DefinedParameterType">
    <xs:annotation><xs:documentation>One definition; ID and phase occur only in the XML structure.</xs:documentation></xs:annotation>
    <xs:complexContent>
      <xs:extension base="ParameterObjectType">
        <xs:attribute name="id" type="xs:string" use="required">
          <xs:annotation><xs:documentation>Unique parameter ID.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="measurementOrder" type="xs:positiveInteger">
          <xs:annotation><xs:documentation>Preserves existing exported post-operative measurement column order.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="DefinedClassType">
    <xs:annotation><xs:documentation>Epic class grouping of already defined fields; unrelated CSV headers are not selected.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="timed" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>When false, pre-operative class values are untimed metadata: show below the chart, never assign an operation-relative time.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="parameter" type="DefinedParameterType" minOccurs="1" maxOccurs="unbounded">
        <xs:annotation><xs:documentation>Parameter defined once inside this Epic class and phase.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Exact Epic class, such as epic.LAB.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="PostDefinedClassType">
    <xs:annotation><xs:documentation>Post-operative Epic class, optionally making a nonmissing value failure.</xs:documentation></xs:annotation>
    <xs:complexContent>
      <xs:extension base="DefinedClassType">
        <xs:attribute name="failure" use="optional" fixed="nonempty">
          <xs:annotation><xs:documentation>Nonblank, nonmissing matching class value including zero is failure.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ParameterMapType">
    <xs:annotation><xs:documentation>Standalone typed parameter-map root. Embedded relevantParameters instead has shared settings and pre/during/post definitions. In post measurement entries, record_scope=patient reads patient-level metadata from any row; the default uses postoperative timestamps. Patient scope cannot use window_hours; runtime checks this.</xs:documentation></xs:annotation>
